# Discord Bot
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
GUILD_ID=your_guild_id_here

# Bot Settings
BOT_PREFIX=!
BOT_STATUS=Greenville RP Romania
BOT_ACTIVITY=playing

# MongoDB
MONGODB_URI=mongodb://localhost:27017/greenville_rp

# Dashboard
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
SESSION_SECRET=your_session_secret_here

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your_32_char_encryption_key

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Verification
VERIFICATION_CHANNEL=
VERIFICATION_LOG_CHANNEL=
VERIFIED_ROLE=
UNVERIFIED_ROLE=

# Tickets
TICKET_CATEGORY=
TICKET_LOG_CHANNEL=
TICKET_STAFF_ROLES=

# Security
MAX_JOINS_PER_MINUTE=5
MAX_MESSAGES_PER_SECOND=3
MAX_MENTIONS_PER_MESSAGE=5
MAX_LINKS_PER_MESSAGE=3
MAX_JOINS_RAID=10
RAID_WINDOW_MINUTES=5
AUTO_BAN_NEW_ACCOUNT_DAYS=7

# Backup
BACKUP_DIR=./backups
BACKUP_AUTO_INTERVAL=24

# Owner IDs (comma separated)
OWNER_IDS=

# Staff Role IDs (comma separated)
STAFF_ROLE_IDS=
